#!/usr/bin/env bash
# FrameXShot AppRun — extracts the AppImage to a per-version cache and
# re-execs the binary from there.
#
# WHY THIS EXISTS
#   The default AppImage launcher uses libfuse to FUSE-mount the AppImage
#   into a private namespace at /tmp/.mount_xxxxxx. Inside that namespace,
#   WebKitGTK's display/EGL detection picks the wrong backend on COSMIC
#   and several other Wayland compositors, and the WebProcess spins in an
#   init retry loop (the user-visible 38% CPU) while the main window
#   paints blank.
#
#   `pnpm tauri dev` never enters the FUSE namespace, which is why dev
#   works but the AppImage doesn't.
#
# WHAT THIS DOES
#   On first run, extract the AppImage to $XDG_CACHE_HOME/framexshot/$VERSION/
#   and re-exec the cached binary. Subsequent runs reuse the cache (instant
#   launch). The cached binary runs in the normal filesystem namespace, so
#   WebKit sees the real /dev/dri, /run/wayland-*, etc. and starts cleanly.
#
# NO FUSE REQUIRED
#   The user no longer needs FUSE installed — extraction is just a
#   `cat AppImage | unsquashfs -d cache` (which the AppImage runtime does
#   internally when --appimage-extract is passed).

set -euo pipefail

# APPDIR is provided by the AppImage runtime (the mount point of the
# FUSE filesystem, or the dir containing us when extracted).
APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"
APPIMAGE="${APPIMAGE:-$(readlink -f "$0" 2>/dev/null || echo "")}"

# Extract a version stamp from the binary so the cache invalidates on upgrade.
VERSION=$(strings "$APPDIR/usr/bin/framexshot" 2>/dev/null \
  | grep -oE 'framexshot [0-9]+\.[0-9]+\.[0-9]+' \
  | head -1 \
  | awk '{print $2}')
: "${VERSION:=current}"

CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/framexshot"
EXTRACT_DIR="$CACHE_BASE/$VERSION/squashfs-root"
LOCK_FILE="$CACHE_BASE/$VERSION/.extract.lock"

# Fast path: already extracted.
if [[ -x "$EXTRACT_DIR/usr/bin/framexshot" ]]; then
    exec "$EXTRACT_DIR/usr/bin/framexshot" "$@"
fi

# Slow path: extract on first launch. Use a per-user lock so two
# concurrent launches of the same AppImage don't extract twice.
mkdir -p "$CACHE_BASE/$VERSION"
(
    flock 9
    if [[ -x "$EXTRACT_DIR/usr/bin/framexshot" ]]; then
        exit 0
    fi
    # Stale extraction from a previous failed run?
    [[ -d "$EXTRACT_DIR" ]] && rm -rf "$EXTRACT_DIR"
    mkdir -p "$EXTRACT_DIR"

    # Ask the AppImage runtime to extract into our cache. The runtime
    # is the very script we're executing, but with --appimage-extract
    # as the first arg it ignores everything and just dumps squashfs-root
    # into CWD. We chdir first so the output lands in our cache.
    (
        cd "$CACHE_BASE/$VERSION"
        if [[ -n "$APPIMAGE" && -f "$APPIMAGE" ]]; then
            "$APPIMAGE" --appimage-extract >/dev/null 2>&1
        else
            # No $APPIMAGE set (e.g. running extracted). Just copy.
            cp -r "$APPDIR/." "$EXTRACT_DIR/"
        fi
    )
) 9>"$LOCK_FILE"

if [[ ! -x "$EXTRACT_DIR/usr/bin/framexshot" ]]; then
    echo "FrameXShot AppRun: extraction failed — falling back to in-place launch" >&2
    exec "$APPDIR/usr/bin/framexshot" "$@"
fi

exec "$EXTRACT_DIR/usr/bin/framexshot" "$@"
