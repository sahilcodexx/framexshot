# FrameXShot — AppImage build in a container
#
# Why this exists:
#   The Tauri AppImage bundler (`linuxdeploy`) is pinned to binutils 2.35
#   (2020). Modern glibc (2.36+) added `.relr.dyn` RELR relocation sections
#   that binutils 2.35 can't parse. On rolling Linux distros (CachyOS,
#   Arch, Manjaro, openSUSE Tumbleweed, Fedora rawhide) the AppImage
#   build therefore aborts with:
#     failed to bundle project: `failed to run linuxdeploy`
#
#   This Dockerfile builds the AppImage in Ubuntu 24.04, which still
#   ships glibc 2.39 — no .relr.dyn, so linuxdeploy works. The output
#   is an AppImage that runs on every Linux distro.
#
# Usage:
#   docker build -f Dockerfile.appimage -t framexshot-appimage .
#   docker run --rm -v "$PWD":/out framexshot-appimage
#   → /out/FrameXShot-x86_64.AppImage   (the same artifact the CI uploads)
#
# Or with docker compose:
#   docker compose -f docker-compose.appimage.yml run build
#
# Memory: peak ~3 GB during Rust release build. Allow 10 GB of disk.

# ── Build stage ──────────────────────────────────────────────────────
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV NODE_VERSION=22
ENV PNPM_VERSION=11
ENV PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin

# System deps required by the Tauri AppImage bundle:
#   - webkit2gtk-4.1-dev, libgtk-3-dev, libayatana-appindicator3-dev, librsvg2-dev
#     → Tauri/WebKit GUI runtime
#   - libxdo-dev  → xdotool for the on-canvas text tool
#   - libpipewire-0.3-dev, libgbm-dev, libdrm-dev
#     → for the wlroots/Hyprland capture path
#   - patchelf, build-essential, file
#     → Tauri bundler (linuxdeploy-plugin-gtk) requires these
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential patchelf file curl ca-certificates wget gnupg \
        libclang-dev cmake \
        libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
        librsvg2-dev libxdo-dev libpipewire-0.3-dev libgbm-dev libdrm-dev \
        libsoup-3.0-dev libjavascriptcoregtk-4.1-dev \
        libssl-dev libgtk-3-bin gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (matches the matrix build in .github/workflows/release.yml)
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm i -g pnpm@${PNPM_VERSION}

# Rust stable (matches the CI matrix: dtolnay/rust-toolchain@stable)
# Install via rustup so the toolchain matches the GitHub Actions runners
# (Rust 1.x stable, channel default).
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path \
    && chmod -R a+rX /usr/local/rustup /usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

WORKDIR /src

# Copy just the manifests so we can pre-fetch cargo + pnpm deps without
# copying the full source tree yet. This layer caches well.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock ./src-tauri/
COPY src-tauri/tauri.conf.json ./src-tauri/

# Pre-cache cargo deps. Create stub main.rs and lib.rs because the real
# Cargo.toml has [lib] name = "framexshot_lib" which requires src/lib.rs.
RUN cd src-tauri && mkdir -p src bin && \
    echo 'fn main() { println!("warmup"); }' > src/main.rs && \
    echo '// warmup stub; replaced by the real build step below' > src/lib.rs && \
    cargo fetch

# Build the AppImage
# Set NO_STRIP=1 so Tauri does not invoke linuxdeploy's bundled strip
# (which is binutils 2.35 and would fail on modern glibc anyway, but
# being explicit avoids a "strip failed" warning).
ENV NO_STRIP=1
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm tauri build --bundles appimage

# ── Output stage ─────────────────────────────────────────────────────
FROM scratch AS output
# Pull just the artifact out — a real AppImage is a position-independent
# static binary, so a scratch stage is safe. The user runs:
#   docker run --rm -v "$PWD":/out framexshot-appimage
# and a fresh AppImage is dropped into $PWD.
COPY --from=builder /src/src-tauri/target/release/bundle/appimage/ /out/
